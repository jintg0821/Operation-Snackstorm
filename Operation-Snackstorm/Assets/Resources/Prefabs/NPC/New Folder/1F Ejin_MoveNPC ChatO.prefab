  chats:
  - "\uB204\uAC00 \uAD50\uB0B4 \uBC29\uC1A1\uC73C\uB85C \uC7A5\uB09C\uC744 \uCE58\uB294
    \uBAA8\uC591\uC774\uC57C"
  - "\uB204\uAC00 \uAD50\uC7A5\uC2E4\uC5D0 \uAF30\uC9C8\uB7EC\uC11C \uC0AC\uD68C\uC324
    \uC9D5\uACC4 \uBA39\uC5C8\uB300"
  - "\uACFC\uD559\uC2E4\uC5D0 \uC88B\uC740 \uAC70 \uC788\uB294 \uAC70\uC9C0?"
  - "\uBBF8\uC220\uC2E4\uC5D0 \uB204\uAC00 \uC7A5\uB09C \uCCE4\uB300."
  - "\uAD50\uBB34\uC2E4\uC5D0 \uC120\uC0DD\uB2D8 \uC2EC\uBD80\uB984\uB9CC \uD558\uBA74
    \uB3C8\uC900\uB300"
  - "1\uCE35 \uC120\uBC30\uB294 \uCC28\uD53C \uC774\uC9C4\uC774\uB77C\uC11C \uAC00\uC624\uB9CC
    \uBD80\uB824"
  - "2\uCE35 \uC120\uBC30\uB294 \uC0A5\uB72F\uB294 \uAC70 \uC880 \uC5D0\uBC14\uC57C"
  - "\uBB34\uC2A8 \uD559\uAD50\uC5D0\uC11C \uC2A4\uCF00\uC774\uD2B8 \uBCF4\uB4DC\uC784?
    \u3139\u3147 \uBB54 \uAC10\uC131\uC784?"
  - "\uBB34\uC2A8 \uD559\uAD50\uC5D0\uC11C \uC2A4\uCF00\uC774\uD2B8 \uBCF4\uB4DC\uC784?
