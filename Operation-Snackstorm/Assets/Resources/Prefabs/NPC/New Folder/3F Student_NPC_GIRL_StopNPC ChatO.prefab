  - "\uAC19\uC740 \uD559\uB144\uC778 \uAC8C \uCC3D\uD53C\uD558\uB2E4."
  - "\uD654\uC7A5\uC2E4\uC5D0\uC11C \uAC78\uB808 \uAF2D \uBE68\uC544\uC57C\uD574!"
  - "\uC7E4\uB294 \uC9C4\uC9DC \uCC10\uB530\uCC98\uB7FC \uC0DD\uACBC\uB124"
