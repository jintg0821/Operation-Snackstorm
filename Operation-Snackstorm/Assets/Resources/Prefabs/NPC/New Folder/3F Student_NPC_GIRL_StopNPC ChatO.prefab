  - "\uB204\uAC00 \uAD50\uB0B4 \uBC29\uC1A1\uC73C\uB85C \uC7A5\uB09C\uC744 \uCE58\uB294
    \uBAA8\uC591\uC774\uC57C"
  - "\uAD50\uB0B4\uBC29\uC1A1 \uBE68\uAC04\uBD88\uC740 \uAC77\uAC8C \uB9CC\uB4E0\uB300"
  - "\uCD08\uB85D\uBD88\uC740 \uAC77\uC9C0\uB9D0\uACE0 \uB6F0\uC5B4\uB77C"
  - "\uBCF4\uB77C\uC0C9\uC740 \uC911\uB9BD \uBA48\uCDB0\uC57C\uD568 \u314B"
  - "\uAD50\uBB34\uC2E4\uC5D0 \uC120\uC0DD\uB2D8 \uC2EC\uBD80\uB984\uB9CC \uD558\uBA74
    \uB3C8\uC900\uB300"
  - "\uC815\uC218\uAE30 \uC2EC\uBD80\uB984\uC744 \uC65C \uC2DC\uD0B4? \uC6B0\uB9AC\uAC00
    \uB178\uC608\uC784?"
  - "\uC544\uB2C8 \uC120\uC0DD\uB2D8\uC774 \uADF8\uB807\uAC8C \uBE8F\uC5B4\uB3C4
